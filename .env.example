# Copy to .env and replace every sample secret before starting Compose.
POSTGRES_USER=kasane
POSTGRES_DB=kasane
# Optional absolute paths on the Docker host. Empty uses existing named volumes.
# Dokploy: /mnt/data/kasane/postgres and /mnt/data/kasane/qdrant
POSTGRES_STORAGE=
QDRANT_STORAGE=
# Compose passes this separately from DATABASE_URL, preserving reserved characters.
# Single-quote values containing $ to prevent Compose interpolation.
POSTGRES_PASSWORD=replace-with-a-long-random-password
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
PUBLIC_URL=http://localhost:9090
# Optional separate MCP origin, e.g. https://mcp.kasane.example.com (no /mcp suffix).
MCP_PUBLIC_URL=
LISTEN_ADDR=:9090
TRUSTED_PROXY_CIDRS=
KASANE_ADMIN_PASSWORD=replace-with-a-long-password

# Optional standalone relevance service; token stays on the backend.
DECISION_API_URL=
DECISION_API_TOKEN=
# Local processes may use DECISION_API_TOKEN_FILE instead.

# Agent evaluation capture is off by default. Set 1..365 days after publishing
# your raw-data and backup retention policy; e.g. 30 for a 30-day review queue.
DECISION_FEEDBACK_RETENTION_DAYS=0
