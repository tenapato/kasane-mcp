# Copy to .env and replace every sample secret before starting Compose.
POSTGRES_USER=kasane
POSTGRES_DB=kasane
# Compose passes this separately from DATABASE_URL, preserving reserved characters.
# Single-quote values containing $ to prevent Compose interpolation.
POSTGRES_PASSWORD=replace-with-a-long-random-password
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
PUBLIC_URL=http://localhost:8080
# Optional separate MCP origin, e.g. https://mcp.kasane.example.com (no /mcp suffix).
MCP_PUBLIC_URL=
LISTEN_ADDR=:8080
TRUSTED_PROXY_CIDRS=
KASANE_ADMIN_PASSWORD=replace-with-a-long-password
